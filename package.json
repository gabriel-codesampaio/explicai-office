{
  "name": "explicai-office",
  "version": "0.1.0",
  "description": "Escritório virtual em pixel art para ver a equipe de agentes do Explicaí trabalhando no Claude Code. Só leitura, tudo local. Baseado no Escrithorius. / Pixel-art virtual office to watch the Explicaí agent team working in Claude Code. Read-only, fully local. Based on Escrithorius.",
  "main": "main.js",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "test:ui": "electron test-ui/interface.js && electron test-ui/avisos.js",
    "test:exe": "node test-ui/exe.js"
  },
  "keywords": [
    "claude-code",
    "electron",
    "observabilidade",
    "pixel-art",
    "explicai",
    "agents"
  ],
  "author": "Gabriel Sampaio",
  "license": "MIT",
  "type": "commonjs",
  "private": true,
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.explicai-office",
    "productName": "Explicaí Office",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json",
      "build/icone.png"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icone.ico",
      "signExecutable": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "artifactName": "explicai-office-${version}-portable.exe"
  },
  "engines": {
    "node": ">=20"
  },
  "contributors": [
    "Thales de Souza Guasti (Escrithorius, projeto original)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gabriel-codesampaio/explicai-office.git"
  }
}
